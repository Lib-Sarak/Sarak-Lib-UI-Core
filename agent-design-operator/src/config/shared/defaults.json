{
  "vectorization": {
    "top_k": 4,
    "similarity_threshold": 0.7
  },
  "llm": {
    "temperature": 0.7,
    "max_tokens": 1000,
    "provider": "groq",
    "model": "openai/gpt-oss-20b",
    "retries": {
      "enabled": true,
      "max_attempts": 3,
      "initial_delay_ms": 1000
    }
  },
  "database": {
    "table_history": "chat_history",
    "table_leads": "leads",
    "table_triggers": "trigger_events",
    "table_knowledge": "knowledge_embeddings",
    "table_state": "session_state",
    "chat_history_limit": 15
  },
  "embeddings_provider": "local",
  "security": {
    "api_auth": {
      "enabled": true
    },
    "cors": {
      "allowed_origins": ["*"]
    },
    "rate_limit": {
      "enabled": true,
      "max_requests": 15,
      "window_seconds": 60
    },
      "prompt_injection": {
        "enabled": true,
        "blocked_keywords": [
          "ignore all previous",
          "system prompt",
          "bypass",
          "jailbreak",
          "forget everything"
        ]
      }
    },
    "features": {
      "rag": false
    }
}
