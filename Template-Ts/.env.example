# INFRASTRUCTURE PERSISTENCE TOGGLE
# options: local (in-memory mock database and vector store), cloud (relational postgresql with pgvector)
PERSISTENCE_ENV=local

# SENSITIVE CREDENTIALS & CONNECTION STRINGS
# Database URL is generic PostgreSQL connection string
DATABASE_URL="postgresql://localhost:5432/dbname"

# AI Provedores API Keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
EMBEDDINGS_API_KEY=
