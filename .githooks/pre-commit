#!/bin/sh
# --- Sarak Git Hook (Pre-Commit) ---
#
# Pipeline de validação por commit (spec: specs/specs/02-enforcement-por-commit.md).
#   Anel 0 — segredos + índice de agentes  : SEMPRE roda.
#   Anel 1 — gates de contrato (verdes)    : BLOQUEIA no vermelho.
#   Anel 2 — run_audit + tsc (baseline)    : BLOQUEIA só em REGRESSÃO.
# Os Anéis 1 e 2 são pulados quando o commit não toca código nem artefato gerado.
#
# POSIX sh (Git Bash no Windows). Nada de PowerShell aqui dentro.

if command -v python >/dev/null 2>&1; then PY=python; else PY=python3; fi

# =============================================================================
# ANEL 0 — Segurança e índice (custo desprezível, sempre roda)
# =============================================================================
echo "[Sarak] Anel 0 — verificando vazamento de segredos no staged..."
"$PY" gates/scripts/segredo/verificar_commit.py --raiz .
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "⛔ COMMIT BLOQUEADO — segredo ou arquivo sensível detectado no staged."
  echo "   Corrija: mova o segredo para .env (e adicione ao .gitignore) e re-stage."
  exit 1
fi
echo "[Sarak] Anel 0 OK — nenhum segredo no staged."

# Auto-Indexador da Inteligência Local
echo "[Sarak] Atualizando indice local de agentes..."
"$PY" .agents/gerar_indice.py
git add .agents/index.md

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# =============================================================================
# ANEL 1 (plan×índice) — roda sempre que o staged toca specs/plan/ ou o índice,
# INDEPENDENTE de tocar código: é justamente o commit "só spec" (revisor
# aprovando/sincronizando) que historicamente derrapou (plan-02, plan-13).
# =============================================================================
TOCA_PLAN_OU_INDICE=$(echo "$STAGED" | grep -E '^specs/(plan/|00-indice\.md$)' | head -n 1)
if [ -n "$TOCA_PLAN_OU_INDICE" ]; then
  echo "[Sarak] Anel 1 — sincronia plan × 00-indice..."
  if ! node gates/scripts/contrato/check-plan-index-sync.mjs; then
    echo ""
    echo "⛔ COMMIT BLOQUEADO — Anel 1: sincronia plan × 00-indice"
    echo "   Regra violada : vão nº 12 (specs/specs/01-gates-e-baseline.md §9.2)"
    echo "   Veja o detalhe: npm run plan-index:check"
    exit 1
  fi
  echo "[Sarak] Anel 1 (plan×índice) OK."
fi

# =============================================================================
# ESCOPO — o que este commit toca decide o que mais precisa rodar
# =============================================================================
# Anel 1 (contrato) só interessa quando o commit mexe no código da lib ou nos
# artefatos gerados a partir dele. `check-section-pointers.mjs` (ponteiro de
# seção, §N.N) NASCE com dívida conhecida (vão nº 7) — por isso ele NÃO é
# Anel 1 "verde ou nada": entrou no `run_audit.mjs` e é cobrado pelo Anel 2,
# contra baseline, como os outros auditores com dívida tolerada.
TOCA_CODIGO=$(echo "$STAGED" | grep -E '^(src/|scripts/|docs/|sarak-ui/|bin/|package\.json|\.githooks/|gates/)' | head -n 1)
# specs/ (exceto plan/, já coberto acima — POSIX ERE não tem negative
# lookahead, por isso a lista explícita), .agents/skills/, sarak-dev/ são o
# domínio do detector de ponteiro de seção e não tocam código — precisam
# disparar o Anel 2 mesmo quando TOCA_CODIGO for vazio.
TOCA_DOC_COM_SECAO=$(echo "$STAGED" | grep -E '^(specs/specs/|specs/adr/|specs/arquitetura/|specs/00-|\.agents/skills/|sarak-dev/)' | head -n 1)
# O tsc só faz sentido quando o commit mexe em TypeScript.
TOCA_TS=$(echo "$STAGED" | grep -E '\.tsx?$' | head -n 1)

if [ -z "$TOCA_CODIGO" ] && [ -z "$TOCA_DOC_COM_SECAO" ]; then
  echo "[Sarak] Anéis 1 e 2 PULADOS — o commit não toca src/, scripts/, docs/, sarak-ui/, bin/, package.json, .githooks/, gates/ nem specs/skills com ponteiro de seção."
  echo "[Sarak] Commit liberado."
  exit 0
fi

if [ -z "$TOCA_CODIGO" ]; then
  echo "[Sarak] Anel 1 PULADO — o commit só toca doc/spec (nenhum gate de contrato de código a rodar)."
fi

# =============================================================================
# ANEL 1 (kit do mantenedor) — dev-kit:check. plan-52, decisão do dono
# (2026-08-18): passa a BLOQUEAR o commit. O gatilho é a UNIÃO de TOCA_CODIGO
# e TOCA_DOC_COM_SECAO, não só TOCA_CODIGO — colocá-lo dentro do `if [ -n
# "$TOCA_CODIGO" ]` do Anel 1 de contrato NÃO resolveria: sarak-dev/state.json
# carrega a LISTA DE ARQUIVOS de specs/specs|adr|arquitetura
# (specs/specs/14-artefatos-do-mantenedor.md §3), então criar ou remover uma
# spec defasa o kit mesmo sem tocar código — e esse é justamente o gatilho que
# hoje só dispara o Anel 2. Por isso este bloco fica FORA do `if TOCA_CODIGO`:
# chegar até aqui (passado o `exit 0` de cima) já prova que pelo menos um dos
# dois gatilhos disparou. Precedente de forma: check-plan-index-sync, acima,
# também tem gatilho próprio, fora da estrutura de anéis.
#
# Bloqueia por DUAS causas independentes (spec 14 §4): defasagem de número E
# ponteiro morto na prosa do guia — um caminho, gate ou comando `node` citado
# em crase que não existe mais. É mudança de comportamento deliberada: hoje um
# ponteiro morto no guia não impede commit nenhum; a partir daqui, impede.
# =============================================================================
echo "[Sarak] Anel 1 (kit do mantenedor) — sarak-dev/ em dia..."
if ! node scripts/generate-dev-kit.mjs --check; then
  echo ""
  echo "⛔ COMMIT BLOQUEADO — Anel 1: kit do mantenedor"
  echo "   Regra violada : R17 · R23 · R29 (specs/specs/00-regras-e-invariantes.md)"
  echo "   Veja o detalhe: npm run dev-kit:check"
  echo "   Conserto      : npm run dev-kit && git add sarak-dev/"
  exit 1
fi
echo "[Sarak] Anel 1 (kit do mantenedor) OK — sem defasagem nem ponteiro morto."

# =============================================================================
# ANEL 1 — Gates de contrato. Verde é a única saída aceitável.
# =============================================================================
echo "[Sarak] Anel 1 — gates de contrato (barril, catálogo, zero-marca, kit)..."

if [ -n "$TOCA_CODIGO" ]; then
anel1() {
  # $1 = rótulo | $2 = regra violada | $3 = comando npm equivalente | $4.. = script + flags
  rotulo="$1"; regra="$2"; comando="$3"; shift 3
  if ! node "$@"; then
    echo ""
    echo "⛔ COMMIT BLOQUEADO — Anel 1: $rotulo"
    echo "   Regra violada : $regra (specs/specs/00-regras-e-invariantes.md)"
    echo "   Veja o detalhe: $comando"
    exit 1
  fi
}

anel1 "paridade do barril público" "R14 — Barril completo" "npm run barrel:check" gates/scripts/contrato/check-barrel-parity.mjs --check
anel1 "catálogo de componentes"    "R17 — Não transcrever fonte viva" "npm run catalog:check" scripts/generate-component-catalog.mjs --check
anel1 "zero-marca"                 "R12 — A lib nunca estampa a própria marca" "npm run zero-brand:check" gates/scripts/contrato/check-zero-brand.mjs --check
anel1 "kit do consumidor"          "R17 — Não transcrever fonte viva" "npm run guide:check" scripts/generate-consumer-kit.mjs --check
anel1 "zero deep import"           "R27 — O consumidor nunca precisa de deep import" "npm run deep-import:check" gates/scripts/contrato/check-no-deep-import.mjs
anel1 "limites declarados dos gates" "R18 — Todo gate declara o que NÃO vê" "npm run gate-limits:check" gates/scripts/contrato/check-gate-limits.mjs
# plan-52: os três abaixo já existiam em package.json, verdes, e não rodavam em
# lugar nenhum (nem hook, nem gates:full, nem run_audit). Custam o mesmo que os
# gates acima (~0,7-0,9s) — entram pelo mesmo molde `anel1()`.
anel1 "container query sem interpolação"   "— (plan-39 · endurecido pela plan-44)" "npm run container-query:check" gates/scripts/contrato/check-container-query-literal.mjs
anel1 "container query com boundary"       "— (plan-41)" "npm run container-query-boundary:check" gates/scripts/contrato/check-container-query-boundary.mjs
anel1 "paridade doc × código de persistência" "R17 — Não transcrever fonte viva" "npm run persistence-doc:check" gates/scripts/contrato/check-persistence-doc-identifiers.mjs
# `build-info:check` NÃO entra aqui, mesmo motivo do `package:check` (spec 02
# §4.1): exige `dist/` buildado. Mora só no `gates:full`.

echo "[Sarak] Anel 1 OK — barril, catálogo, zero-marca e kit em dia."

# tsx custa ~3s (spawn de processo próprio) — separado do bloco acima para não
# distorcer o custo medido dos quatro gates originais (spec 02, §2.2).
if ! npx tsx scripts/generate-token-types.ts --check; then
  echo ""
  echo "⛔ COMMIT BLOQUEADO — Anel 1: tipos de token gerados"
  echo "   Regra violada : R4 / R29 (specs/specs/00-regras-e-invariantes.md)"
  echo "   Veja o detalhe: npm run token-types:check"
  exit 1
fi
echo "[Sarak] Anel 1 (tipos de token) OK."
fi

# =============================================================================
# ANEL 2 — Auditoria contra baseline VERSIONADO. Bloqueia só se PIOROU.
# =============================================================================
if [ -n "$TOCA_TS" ]; then
  echo "[Sarak] Anel 2 — auditoria + tsc contra gates/baselines/audit-baseline.json..."
  node gates/scripts/release/check-audit-baseline.mjs --with-tsc
else
  echo "[Sarak] Anel 2 — auditoria contra gates/baselines/audit-baseline.json (tsc pulado: nenhum .ts/.tsx no staged)..."
  node gates/scripts/release/check-audit-baseline.mjs
fi
status=$?

if [ "$status" -ne 0 ]; then
  echo ""
  echo "⛔ COMMIT BLOQUEADO — Anel 2: a auditoria PIOROU em relação ao baseline."
  echo "   As regras estão em specs/specs/00-regras-e-invariantes.md."
  echo "   A dívida TOLERADA está em specs/specs/01-gates-e-baseline.md — o que passar dela é seu."
  exit 1
fi

echo "[Sarak] Anel 2 OK — auditoria no baseline (sem regressão)."
echo "[Sarak] Commit liberado. Anel 3 (suíte, build, package) NÃO roda aqui — rode: npm run gates:full"
exit 0
