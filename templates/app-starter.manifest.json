{
  "$comment": "Template oficial de aplicação Sarak (copie para o seu projeto e edite). Contrato: a rota /design (CustomizationPanel) e o item 'Design Engine' do menu DEVEM permanecer — é a aba de personalização que todo consumidor recebe ao instalar o módulo (gate: StarterManifest.test).",
  "schemaVersion": 1,
  "type": "SarakFlex",
  "shell": {
    "topbar": {
      "type": "SarakFlex",
      "props": {
        "align": "center",
        "justify": "space-between",
        "gap": "spacing-sm",
        "style": { "padding": "var(--sarak-layout-gap-md, 16px)" }
      },
      "children": [
        {
          "type": "SarakTypography",
          "props": { "variant": "h2", "color": "main", "content": "Minha Aplicação Sarak" }
        }
      ]
    },
    "sidebar": {
      "$comment": "orientation é 'auto' por padrão (Spec 18): quando o Design Engine define navigationStyle='topbar', este menu vira horizontal — mova-o para shell.topbar sem mudar mais nada. dock/glass do shell legado ainda não são suportados.",
      "type": "SarakShellNav",
      "props": {
        "brand": { "name": "Sarak" },
        "activeRoute": "{{$route}}",
        "items": [
          { "label": "Início", "icon": "Home", "route": "/" },
          { "label": "Design Engine", "icon": "Palette", "route": "/design", "category": "Sistema" }
        ]
      },
      "actions": [{ "type": "navigate", "payload": { "to": "{{$event}}" } }]
    },
    "content": "<slot-rotas>"
  },
  "routes": {
    "/": {
      "type": "SarakFlex",
      "props": {
        "direction": "column",
        "gap": "spacing-md",
        "style": { "padding": "var(--sarak-layout-gap-lg, 24px)" }
      },
      "children": [
        {
          "type": "SarakTypography",
          "props": { "variant": "h1", "color": "main", "content": "Bem-vindo 👋" }
        },
        {
          "type": "SarakTypography",
          "props": {
            "variant": "body",
            "color": "secondary",
            "content": "Esta tela é 100% declarativa: edite o manifesto JSON para construir o seu sistema. O catálogo oficial de componentes, props e ações está em node_modules/@sarak/lib-ui-core/docs/manifest-catalog.md."
          }
        },
        {
          "type": "SarakButton",
          "props": { "variant": "primary" },
          "actions": [
            {
              "type": "trigger_toast",
              "payload": { "message": "O motor declarativo está funcionando!", "variant": "success" }
            }
          ],
          "children": [
            { "type": "SarakTypography", "props": { "variant": "body", "color": "main", "content": "Testar feedback" } }
          ]
        }
      ]
    },
    "/design": {
      "type": "CustomizationPanel"
    }
  }
}
