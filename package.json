{
    "name": "@sarak/lib-ui-core",
    "version": "2.2.9",
    "description": "Sarak Design System and UI Engine [Pre-compiled]",
    "type": "module",
    "style": "./dist/sarak.css",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build:css": "npx @tailwindcss/cli -i ./src/styles/sarak-base.css -o ./dist/sarak.css --minify",
        "build:js": "tsup src/index.ts --format esm,cjs --shims --dts --clean --minify --external react,react-dom,framer-motion,lucide-react,recharts,echarts-for-react,echarts,reactflow,react-grid-layout,react-markdown,react-syntax-highlighter,react-dropzone,pdfjs-dist,clsx,tailwind-merge,date-fns,pg,@tanstack/react-virtual && tsup backend/node/backend-node.ts --format esm,cjs --shims --dts --minify --external pg,better-sqlite3",
        "build:css:scoped": "node scripts/build-scoped-css.mjs",
        "build": "npm run catalog:check && npm run build:js && npm run build:css && npm run build:css:scoped && node scripts/inject-css.mjs",
        "catalog": "node scripts/generate-manifest-catalog.mjs",
        "catalog:check": "node scripts/generate-manifest-catalog.mjs --check",
        "prepublishOnly": "npm run build",
        "test-ct": "playwright test -c playwright-ct.config.ts"
    },
    "typesVersions": {
        "*": {
            "backend/node": ["./dist/backend-node.d.ts"]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./sarak.css": "./dist/sarak.css",
        "./dist/sarak.css": "./dist/sarak.css",
        "./sarak-scoped.css": "./dist/sarak-scoped.css",
        "./dist/sarak-scoped.css": "./dist/sarak-scoped.css",
        "./sarak-base.css": {
            "style": "./src/styles/sarak-base.css",
            "import": "./src/styles/sarak-base.css",
            "default": "./src/styles/sarak-base.css"
        },
        "./backend/node": {
            "types": "./dist/backend-node.d.ts",
            "import": "./dist/backend-node.js",
            "require": "./dist/backend-node.cjs"
        }
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@tabler/icons-react": "^3.44.0",
        "dompurify": "^3.4.11"
    },
    "peerDependencies": {
        "@tanstack/react-virtual": ">=3.0.0",
        "axios": "^1.6.0",
        "better-sqlite3": ">=9.0.0",
        "clsx": ">=2.1.0",
        "date-fns": ">=3.3.0",
        "echarts": ">=5.5.0",
        "echarts-for-react": ">=3.0.0",
        "framer-motion": ">=11.0.0",
        "lucide-react": ">=0.284.0",
        "pdfjs-dist": ">=4.0.0",
        "pg": "^8.21.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-dropzone": ">=14.2.0",
        "react-grid-layout": ">=1.4.0",
        "react-markdown": ">=9.0.0",
        "react-syntax-highlighter": ">=15.5.0",
        "reactflow": ">=11.10.0",
        "recharts": ">=2.12.0",
        "tailwind-merge": ">=2.2.0",
        "tailwindcss": ">=4.0.0"
    },
    "devDependencies": {
        "@playwright/experimental-ct-react": "^1.60.0",
        "@playwright/test": "^1.44.0",
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/react-virtual": "^3.14.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/pg": "^8.20.0",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "@types/react-syntax-highlighter": "^15.5.11",
        "@vitest/coverage-v8": "^4.1.8",
        "better-sqlite3": "^12.11.1",
        "clsx": "^2.1.0",
        "date-fns": "^3.3.0",
        "echarts": "^5.5.0",
        "echarts-for-react": "^3.0.2",
        "framer-motion": "^11.0.0",
        "jsdom": "^29.1.1",
        "lightningcss": "^1.32.0",
        "lucide-react": "^0.284.0",
        "pdfjs-dist": "^6.0.227",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "react-dropzone": "^14.2.3",
        "react-grid-layout": "^1.4.4",
        "react-markdown": "^9.0.1",
        "react-syntax-highlighter": "^15.5.0",
        "reactflow": "^11.10.1",
        "recharts": "^2.12.2",
        "tailwind-merge": "^2.2.1",
        "tailwindcss": "^4.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^4.1.8"
    }
}
