{
    "name": "@sarak/lib-ui-core",
    "version": "6.0.0",
    "description": "Sarak Design System and UI Engine [Pre-compiled]",
    "type": "module",
    "style": "./dist/sarak.css",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "sarak-ui": "./bin/sarak-ui.mjs"
    },
    "files": [
        "dist",
        "bin",
        "!bin/**/__tests__/**",
        "docs",
        "sarak-ui"
    ],
    "scripts": {
        "build:css": "npx @tailwindcss/cli -i ./src/styles/sarak-base.css -o ./dist/sarak.css --minify",
        "build:js": "tsup src/index.ts --format esm,cjs --shims --dts --clean --minify --external react,react-dom,framer-motion,lucide-react,recharts,echarts-for-react,echarts,reactflow,react-grid-layout,react-markdown,react-syntax-highlighter,react-dropzone,pdfjs-dist,clsx,tailwind-merge,date-fns,@tanstack/react-virtual",
        "build:css:scoped": "node scripts/build-scoped-css.mjs",
        "build": "npm run token-types:check && npm run catalog:check && npm run barrel:check && npm run zero-brand:check && npm run guide:check && npm run deep-import:check && npm run build:js && npm run public-types:check && npm run build:css && npm run build:css:scoped && node scripts/copy-base-css.mjs && node scripts/inject-css.mjs && node scripts/generate-build-info.mjs",
        "catalog": "node scripts/generate-component-catalog.mjs",
        "catalog:check": "node scripts/generate-component-catalog.mjs --check",
        "guide": "node scripts/generate-consumer-kit.mjs",
        "guide:check": "node scripts/generate-consumer-kit.mjs --check",
        "dev-kit": "node scripts/generate-dev-kit.mjs",
        "dev-kit:check": "node scripts/generate-dev-kit.mjs --check",
        "token-types": "npx tsx scripts/generate-token-types.ts",
        "token-types:check": "npx tsx scripts/generate-token-types.ts --check",
        "build-info:check": "node scripts/generate-build-info.mjs --check",
        "barrel:check": "node gates/scripts/contrato/check-barrel-parity.mjs --check",
        "zero-brand:check": "node gates/scripts/contrato/check-zero-brand.mjs --check",
        "plan-index": "node scripts/generate-plan-index.mjs",
        "plan-index:check": "node gates/scripts/contrato/check-plan-index-sync.mjs && node scripts/generate-plan-index.mjs --check",
        "deep-import:check": "node gates/scripts/contrato/check-no-deep-import.mjs",
        "container-query:check": "node gates/scripts/contrato/check-container-query-literal.mjs",
        "persistence-doc:check": "node gates/scripts/contrato/check-persistence-doc-identifiers.mjs",
        "public-types:check": "node gates/scripts/contrato/check-public-types-parity.mjs --check",
        "container-query-boundary:check": "node gates/scripts/contrato/check-container-query-boundary.mjs",
        "section-pointers:check": "node gates/scripts/contrato/check-section-pointers.mjs",
        "gate-limits:check": "node gates/scripts/contrato/check-gate-limits.mjs",
        "coverage:check": "vitest run --coverage && node gates/scripts/release/check-coverage-floor.mjs",
        "composicao-atomica:check": "node gates/scripts/audit/auditor_composicaoatomica.mjs",
        "package:check": "node gates/scripts/contrato/check-package-contents.mjs",
        "audit": "node gates/scripts/audit/run_audit.mjs",
        "themes:diversity": "npx tsx gates/scripts/audit/verify_diversity.ts",
        "audit:baseline": "node gates/scripts/release/check-audit-baseline.mjs",
        "hooks:install": "node scripts/install-hooks.mjs",
        "gates:full": "npm run dev-kit:check && npm run build && npm run build-info:check && npm run package:check && npm run coverage:check",
        "release:check": "node gates/scripts/release/check-release-tag.mjs",
        "preversion": "npm run gates:full",
        "version": "npm run guide && npm run build && npm run dev-kit && git add package.json package-lock.json dist sarak-ui sarak-dev",
        "postversion": "git push --follow-tags",
        "prepublishOnly": "npm run build && npm run package:check"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./sarak.css": "./dist/sarak.css",
        "./dist/sarak.css": "./dist/sarak.css",
        "./sarak-scoped.css": "./dist/sarak-scoped.css",
        "./dist/sarak-scoped.css": "./dist/sarak-scoped.css",
        "./sarak-base.css": {
            "style": "./dist/styles/sarak-base.css",
            "import": "./dist/styles/sarak-base.css",
            "default": "./dist/styles/sarak-base.css"
        }
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@tabler/icons-react": "^3.44.0",
        "dompurify": "^3.4.11"
    },
    "peerDependencies": {
        "@tanstack/react-virtual": ">=3.0.0",
        "axios": "^1.6.0",
        "clsx": ">=2.1.0",
        "date-fns": ">=3.3.0",
        "echarts": ">=5.5.0",
        "echarts-for-react": ">=3.0.0",
        "framer-motion": ">=11.0.0",
        "lucide-react": ">=0.284.0",
        "pdfjs-dist": ">=4.0.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-dropzone": ">=14.2.0",
        "react-grid-layout": ">=1.4.0",
        "react-markdown": ">=9.0.0",
        "react-syntax-highlighter": ">=15.5.0",
        "reactflow": ">=11.10.0",
        "recharts": ">=2.12.0",
        "tailwind-merge": ">=2.2.0",
        "tailwindcss": ">=4.0.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/react-virtual": "^3.14.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.0.0",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "@types/react-syntax-highlighter": "^15.5.11",
        "@vitest/coverage-v8": "^4.1.8",
        "clsx": "^2.1.0",
        "date-fns": "^3.3.0",
        "echarts": "^5.5.0",
        "echarts-for-react": "^3.0.2",
        "framer-motion": "^11.0.0",
        "jsdom": "^29.1.1",
        "lightningcss": "^1.32.0",
        "lucide-react": "^0.284.0",
        "pdfjs-dist": "^6.0.227",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "react-dropzone": "^14.2.3",
        "react-grid-layout": "^1.4.4",
        "react-markdown": "^9.0.1",
        "react-syntax-highlighter": "^15.5.0",
        "reactflow": "^11.10.1",
        "recharts": "^2.12.2",
        "tailwind-merge": "^2.2.1",
        "tailwindcss": "^4.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^4.1.8"
    }
}
