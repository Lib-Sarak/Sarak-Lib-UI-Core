                        class="bg-[var(--sarak-card-header-bg,transparent)] py-[var(--sarak-card-header-padding,12px)] shadow-[inset_0_calc(var(--sarak-card-border-width,1px)*-1)_0_var(--sarak-card-header-border,transparent)] [&_h1]:!text-[length:min(var(--sarak-card-title-font-size),var(--sarak-h2-size))] [&_h2]:!text-[length:min(var(--sarak-card-title-font-size),var(--sarak-h2-size))] [&_h3]:!text-[length:min(var(--sarak-card-title-font-size),var(--sarak-h2-size))] [&_h4]:!text-[length:min(var(--sarak-card-title-font-size),var(--sarak-h2-size))] [&_h5]:!text-[length:min(var(--sarak-card-title-font-size),var(--sarak-h2-size))] [&_h6]:!text-[length:min(var(--sarak-card-title-font-size),var(--sarak-h2-size))] mx-[calc(var(--sarak-card-padding-md,24px)*-1)] px-[var(--sarak-card-padding-md,24px)]"
                      >
                        <h3
                          data-testid="sample-card-title"
                        >
                          Receita do mês
                        </h3>
                      </header>
                      <div
                        class=""
                      >
                        <p
                          class="text-2xl font-bold"
                          data-testid="sample-card-value"
                        >
                          R$ 12.480,00
                        </p>
                      </div>
                      <footer
                        class="bg-[var(--sarak-card-footer-bg,transparent)] shadow-[inset_0_var(--sarak-card-border-width,1px)_0_var(--sarak-card-footer-border,transparent)] mx-[calc(var(--sarak-card-padding-md,24px)*-1)] px-[var(--sarak-card-padding-md,24px)] py-[var(--sarak-card-header-padding,12px)]"
                      >
                        <span
                          class="inline-flex"
                        >
                          <button
                            class="flex justify-center items-center gap-2 w-max min-w-fit flex-row font-black uppercase tracking-widest transition-all active:[transition-duration:var(--sarak-motion-dur-instant,0.1s)] focus:outline-none rounded-btn py-2 px-4 text-sm bg-[var(--sarak-btn-primary-bg,#19e3f0)] text-[var(--sarak-btn-primary-text,#04121a)] hover:brightness-110 active:scale-[0.98] shadow-xl shadow-[var(--sarak-primary-color,#19e3f0)]/20"
                            tabindex="-1"
                          >
                            <span>
                              Ver detalhes
                            </span>
                          </button>
                        </span>
                      </footer>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="flex flex-col gap-1 border-t border-theme-border p-3"
            >
              <h3
                class="text-sm font-bold uppercase tracking-wider text-theme-text"
              >
                Centralizado
              </h3>
              <p
                class="text-xs text-theme-muted"
              >
                Texto centralizado e cantos redondos: vitrine de destaque ou número grande.
              </p>
            </div>
            <button
              aria-label="Centralizado"
              class="absolute inset-0 p-0 rounded-2xl"
              type="button"
            />
          </div>
        </div>
      </div>
      <button
        aria-expanded="false"
        class="self-start rounded-[var(--sarak-card-radius,10px)] border border-[var(--theme-border)] px-3 py-1.5 text-[length:var(--sarak-type-scale-caption,12px)] font-semibold text-[var(--theme-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--theme-primary)]"
        data-preset-toggle="cards"
        type="button"
      >
        Ver todas (28)
      </button>
    </div>
  </div>
</div>
`;
