    />
    <div
      class="absolute inset-0 origin-top-left overflow-hidden z-10 flex text-[var(--color-theme-title,#ffffff)] font-sans selection:bg-[var(--theme-primary)] selection:text-white layout-sidebar bg-[var(--theme-body)]"
      style="width: 105.26%; height: 105.26%; transform: scale(0.95);"
    >
      <aside
        class="sarak-shell-sidebar flex-shrink-0 h-full transition-all duration-300 z-30 border-r flex flex-col shrink-0 relative z-[100] shadow-2xl overflow-hidden"
        style="width: 240px; opacity: 1; visibility: visible; transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s ease; margin: var(--theme-tab-section-margin, 12px); border-radius: var(--radius-theme, 12px); height: calc(100vh - (var(--theme-tab-section-margin, 12px) * 2)); border-width: 1px; border-style: solid; background-color: var(--theme-sidebar-bg, var(--theme-sidebar)); border-color: var(--theme-border);"
      >
        <div
          class="h-16 sarak-shell-header px-6 flex items-center border-b border-[var(--theme-border)] bg-[var(--theme-title)]/5 justify-between"
        >
