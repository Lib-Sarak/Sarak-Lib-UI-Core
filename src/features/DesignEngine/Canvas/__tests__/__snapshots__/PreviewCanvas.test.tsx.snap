              >
                <aside
                  class="sarak-shell-sidebar flex-shrink-0 h-full transition-all duration-300 z-30 border-r flex flex-col shrink-0 relative z-[100] overflow-hidden"
                  style="width: 250px; opacity: 1; visibility: visible; transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s ease; margin: var(--theme-tab-section-margin, 12px); border-radius: var(--radius-theme, 12px); height: calc(100vh - (var(--theme-tab-section-margin, 12px) * 2)); border-width: 1px; border-style: solid; background-color: var(--theme-sidebar-bg, var(--theme-sidebar)); border-color: var(--theme-border); backdrop-filter: blur(var(--sarak-sidebar-blur, 0px)); box-shadow: var(--sarak-sidebar-shadow, 10px 0 30px rgba(0,0,0,0.5));"
                >
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 pointer-events-none mix-blend-overlay"
                    style="opacity: var(--sarak-sidebar-noise-opacity, 0); background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); background-size: 200px 200px; background-repeat: repeat;"
                  />
                  <div
                    class="h-16 sarak-shell-header px-6 flex items-center border-b border-[var(--theme-border)] bg-[var(--theme-title)]/5 justify-between"
                  >
                    <div
                      class="flex items-center gap-3 w-full "
                    >
                      <div
                        class="w-8 h-8 rounded-[var(--radius-theme)] bg-gradient-to-br from-[var(--theme-primary)] to-[var(--theme-primary-rgb),0.5] flex items-center justify-center font-black text-xs text-[var(--theme-on-primary)] shrink-0"
                      >
                        S
                      </div>
                      <span
                        class="text-sm font-bold tracking-tighter opacity-80 text-[var(--theme-title)] truncate max-w-[var(--sarak-sidebar-label-max-width,120px)]"
