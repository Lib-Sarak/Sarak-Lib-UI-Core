                        style="z-index: var(--sarak-z-sidebar, 500); width: var(--sarak-sidebar-width, 240px); min-width: var(--sidebar-min-width, 150px); max-width: var(--sidebar-max-width, 450px); margin: var(--sarak-tab-section-margin, 8px); height: calc(100% - (var(--sarak-tab-section-margin, 8px) * 2)); background: var(--sarak-sidebar-bg, var(--theme-sidebar-bg, transparent)); border-top-width: 0px; border-right-width: var(--sarak-sidebar-border-width, 1px); border-bottom-width: 0px; border-left-width: 0px; border-style: solid; border-color: var(--sarak-sidebar-border-color, var(--border-color, var(--theme-border, rgba(255,255,255,0.09)))); backdrop-filter: blur(var(--sarak-sidebar-blur, 10px)); box-shadow: var(--sarak-sidebar-shadow, 10px 0 30px rgba(0,0,0,0.5));"
