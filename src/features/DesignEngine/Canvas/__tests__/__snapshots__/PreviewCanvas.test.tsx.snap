                      class="inline-flex items-center justify-center transition-all focus:outline-none rounded-btn flex-shrink-0 w-8 h-8 text-sm bg-transparent text-[var(--sarak-primary-color,#3b82f6)] hover:bg-white/5 active:scale-[0.98]"
                    >
