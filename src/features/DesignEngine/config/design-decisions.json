    {
        "id": "layout",
        "textKey": "decisionLayout",
        "pillars": [
            "navigation"
        ],
        "groups": [
            "globalBlock"
        ],
        "optionSections": [
            "Composição da Barra"
        ],
        "includeGlobal": true,
        "questions": [
            {
                "id": "where",
                "textKey": "barQuestionWhere",
                "tokens": ["navigationStyle", "sidebarPosition", "sidebarWidth", "navbarLayout"],
                "fineMatch": "^(sidebar(Min|Max|Collapsed)Width|topbar(Height|CollapsedHeight)|tabSectionMargin|searchPosition(Sidebar|Topbar)|maxContentWidth)$"
            },
            {
                "id": "how",
                "textKey": "barQuestionHow",
                "tokens": [
                    "sidebarTone", "topbarTone", "sidebarActiveItemStyle", "topbarActiveItemStyle",
                    "sidebarBorderSide", "sidebarBorderStyle", "sidebarBackgroundStyle", "topbarBackgroundStyle",
                    "sidebarItemDensity", "topbarItemDensity"
                ],
                "fineMatch": "^(sidebar|topbar)(Color|Active|Hover|Item|Category|Border|Icon|Blur|Shadow|Noise|GroupSeparator|Title)|^nav(ItemActive|ActiveMarker|ItemRadius)|^tabGap$"
            },
            {
                "id": "what",
                "textKey": "barQuestionWhat",
                "tokens": [
                    "chromeSearchPosition", "chromeUserPosition", "chromeNotificationsPosition",
                    "preferenceModePosition", "preferenceFontSizePosition", "preferenceNavigationStylePosition",
                    "preferenceNavCollapsePosition", "preferenceLanguagePosition"
                ],
                "fineMatch": "^searchDropdown"
            },
            {
                "id": "brand",
                "textKey": "barQuestionBrand",
                "tokens": ["sidebarLogoPlacement", "shellBrandLogoSize", "brandLogoSizeCollapsed", "sidebarLabelMaxWidth"],
                "fineMatch": "^(sidebar|topbar)(Brand|Label)|^topbarLabelMaxWidth$|^identity"
            },
            {
                "id": "behavior",
                "textKey": "barQuestionBehavior",
                "tokens": ["isNavHidden", "sidebarResizable", "isAutoHideEnabled"],
                "fineMatch": "^(isSplitViewEnabled)$"
            }
        ],
        "screen": "dashboard",
        "screens": [
            "dashboard"
        ]
