                <div
                  class="w-5 h-5 rounded transition-all duration-[var(--duration-fast,0.2s)] flex items-center justify-center border"
                  style="background-color: transparent; border-color: var(--sarak-input-border-color, var(--border-color, rgba(255,255,255,0.09))); border-width: 1px; border-style: solid; box-shadow: none;"
                />
              </div>
            </div>
          </label>
        </div>
        <div
          aria-hidden="true"
