                class=""
                fill="none"
                height="12"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="12"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="m21 16-4 4-4-4"
                />
                <path
                  d="M17 20V4"
                />
                <path
                  d="m3 8 4-4 4 4"
                />
                <path
                  d="M7 4v16"
                />
              </svg>
              <span>
                Nome
              </span>
            </button>
          </div>
          <span
            aria-label="Redimensionar coluna name"
            aria-orientation="vertical"
            data-resize-handle="name"
