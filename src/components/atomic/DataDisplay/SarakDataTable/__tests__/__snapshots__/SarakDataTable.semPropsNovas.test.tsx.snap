      >
        <div
          aria-label="Seleção"
          role="columnheader"
          style="width: 48px; flex: 0 0 auto; display: flex; align-items: center; justify-content: center;"
        >
          <label
            class="cursor-pointer"
          >
            <div
              class="flex items-start"
              style="gap: var(--sarak-layout-gap-sm, 12px);"
            >
              <div
                class="relative flex items-center justify-center"
              >
                <input
                  aria-checked="false"
                  aria-label="Selecionar todas as linhas visíveis"
                  class="sr-only"
                  type="checkbox"
